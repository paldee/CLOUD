APP_NAME=agri-dw-llm-agent
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM provider adapter (Qwen via Groq)
LLM_PROVIDER=qwen
# Optional override. Leave blank to use the provider-specific model below.
LLM_MODEL=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Amazon RDS PostgreSQL
DATABASE_URL=postgresql+psycopg://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DATABASE>?sslmode=require
DATABASE_SCHEMA=data_warehouse

# Agent controls
MAX_SQL_ROWS=100
MAX_SQL_SECONDS=15

# AWS services used by the Express web server (local development only).
# On EC2 the instance profile supplies credentials, so leave the keys out there.
PORT=3000
AWS_REGION=us-east-1
S3_BUCKET_NAME=<csv-bucket-created-by-the-stack>
DYNAMODB_TABLE=agrichain_user_login
SESSION_TABLE=agrichain_user_session
CHAT_TABLE=agrichain_chat_history
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
