APP_NAME=agri-dw-llm-agent
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM provider: openai | gemini | anthropic | local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Example PostgreSQL/RDS URL:
# postgresql+psycopg://username:password@rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/data_warehouse
DATABASE_URL=
DATABASE_SCHEMA=data_warehouse

# Agent controls
MAX_SQL_ROWS=100
MAX_SQL_SECONDS=15
