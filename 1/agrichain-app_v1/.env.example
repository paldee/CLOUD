# ===================================================
# AgriChain Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจาก AWS Academy
# cp .env.example .env
# ===================================================

PORT=3000

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket สำหรับ upload CSV
S3_BUCKET_NAME=your-s3-bucket-name

# DynamoDB Table สำหรับ user login
DYNAMODB_TABLE=user_login

# EC2 Public IP (optional - ใช้อ้างอิง)
EC2_PUBLIC_IP=your-ec2-public-ip

# AWS Credentials (รับจาก AWS Academy Lab → AWS Details)
# ⚠️ Token หมดอายุทุก ~4 ชั่วโมง ต้องอัปเดตใหม่
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token
